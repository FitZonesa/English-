let BT=null;
function startBattle(kind){
 const u=cur();
 const last=kind==="grammar"?u.lastBattleDay:u.lastSprintDay;
 if(last===todayKey()&&!(kind==="grammar"?(u.battleBest||0):0)){}
 const bank=kind==="grammar"
  ?GRAMMAR.flatMap(g=>g.quiz.map(q=>({...q})))
  :VOCAB.map(v=>({q:isAR()?`ما معنى <span class='en'>${esc(v.w)}</span>؟`:`What does <b>${esc(v.w)}</b> mean?`,o:shuffle([v.ar,...samplePool(VOCAB.filter(x=>x.id!==v.id),2,dayHash(v.id)).map(x=>x.ar)]),a:null,tag:"vocab"})).map(q=>({...q,a:q.o.indexOf(q.o.find(x=>x===q.o.find(y=>VOCAB.some(v=>v.ar===y)) && y===q.o.find((z,i)=>true)) )}));
 // simpler correct-index resolution for vocab:
 const vbank=VOCAB.map(v=>{const wrongs=samplePool(VOCAB.filter(x=>x.id!==v.id),2,dayHash(v.w)).map(x=>x.ar);const o=shuffle([v.ar,...wrongs]);return{q:isAR()?`ما معنى <span class='en'>${esc(v.w)}</span>؟`:`What does "${esc(v.w)}" mean?`,o,a:o.indexOf(v.ar),tag:"vocab"}});
 const questions=samplePool(kind==="grammar"?bank:vbank,10,Date.now());
 BT={kind,questions,i:0,c:0,deadline:Date.now()+15000,timer:null};
 renderBattle();BT.timer=setInterval(()=>{if(Date.now()>BT.deadline)battleNext(false)},500);
}
function battleNext(ok){
 if(!BT)return;
 if(ok)BT.c++;
 const t=BT.questions[BT.i];recordSkill(t.tag,ok);
 BT.i++;
 if(BT.i>=10){clearInterval(BT.timer);
  const d=U(),u=cur(),key=BT.kind;
  if(key==="grammar"){u.lastBattleDay=todayKey();d.battleBest=Math.max(d.battleBest||0,BT.c)}else{u.lastSprintDay=todayKey();d.sprintBest=Math.max(d.sprintBest||0,BT.c)}
  STORE.save();
  if(BT.c>0)grantXP(2*BT.c,"battle:"+key+":"+todayKey());
  const c=BT.c;BT=null;
  $("#playerhost").innerHTML=`<div id="player"><div class="pbody" style="flex:1;display:flex;align-items:center;justify-content:center"><div class="pcard" style="text-align:center">
   ${ic("zap",44)}<h2 style="margin:12px 0">${c}/10</h2><p class="mini">${T("timedNote")}</p>
   <div class="row" style="justify-content:center;margin-top:18px"><button class="btn pri" data-action="pclose">${isAR()?"تم":"Done"}</button></div>
  </div></div></div>`;
  checkAch();
 }else{BT.deadline=Date.now()+15000;renderBattle()}
}
