/* ================================================================
   SRS (Leitner boxes — intervals in days)
================================================================ */
const BOX_DAYS=[0,1,3,7,16,35];
function vocabDue(){const d=U(),t=todayKey();return Object.entries(d.vocab).filter(([id,v])=>v.box<5&&v.due<=t)}
function vocabAdd(id){const d=U();if(d.vocab[id])return;d.vocab[id]={box:0,due:todayKey(),seen:0,wrong:0,added:Date.now()};STORE.save()}
function vocabRate(id,rate){const d=U();const v=d.vocab[id];if(!v)return;v.seen++;
 if(rate===1){v.wrong++;v.box=0;v.due=todayKey()}
 else if(rate===2){v.box=Math.max(0,v.box-1);v.due=addDays(BOX_DAYS[Math.max(0,v.box)])}
 else if(rate===3){v.box=Math.min(5,v.box+1);v.due=addDays(BOX_DAYS[Math.min(5,v.box)])}
 else{v.box=5;v.due=addDays(60)}
 STORE.save()}
function addDays(n){const d=new Date();d.setDate(d.getDate()+n);return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0')}
const vocabState=id=>{const v=U().vocab[id];if(!v)return T("newW");return v.box>=5?T("mastered"):v.box>=3?T("familiar"):T("learning")};

/* ================================================================
   PROGRESSION — all unlocks are DERIVED from stored records
================================================================ */
function threshold(){return cur()?.prefs?.threshold||80}
function levelUnlocked(lid){
 if(lid==="prea1")return true;
 const i=LVL_INDEX[lid],d=U();
 if(d.placement&&LVL_INDEX[d.placement.level]>=i)return true;
 const prev=LEVELS[i-1];
 if(!prev||prev.planned)return false;
 return d.attempts.some(a=>a.type==="level"&&a.ref===prev.id&&a.pass);
}
function levelProgress(lid){const ls=levelLessons(lid);if(!ls.length)return 0;const d=U();return Math.round(100*ls.filter(l=>d.progress[l.id]?.done).length/ls.length)}
function levelLessonsDone(lid){const ls=levelLessons(lid);const d=U();return ls.every(l=>d.progress[l.id]?.done)}
function currentLevelId(){const d=U();let best="prea1";LEVELS.forEach(l=>{if(!l.planned&&levelUnlocked(l.id)&&(d.progress&&Object.keys(d.progress).some(pid=>LESSONS[pid]&&LESSONS[pid].level===l.id)||l.id===d.placement?.level))best=l.id});return best}
function nextLessonFor(){for(const l of LEVELS){if(l.planned||!levelUnlocked(l.id))continue;for(const ls of levelLessons(l.id)){if(!U().progress[ls.id]?.done)return ls}}return null}
function lessonAvailable(lid){const l=LESSONS[lid];if(!l)return false;if(!levelUnlocked(l.level))return false;
 if(l.type==="assessment")return levelLessonsDone(l.level);
 const seq=levelFlat(l.level);const idx=seq.findIndex(x=>x.id===lid);if(idx<=0)return true;return !!U().progress[seq[idx-1].id]?.done}

/* sample randomized questions from a pool (differs per attempt) */
function samplePool(pool,n,seed=Date.now()){const p=[...pool];const out=[];let s=seed;while(out.length<n&&p.length){s=(s*9301+49297)%233280;const i=Math.floor(s/233280*p.length);out.push(p.splice(i,1)[0])}return out}

