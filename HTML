function renderStep(s){
 if(!s)return"";
 const A=(inner)=>`<div class="pop">${inner}</div>`;
 switch(s.t){
 case "info":
  return A(`<h2 class="qtext" style="font-size:22px">${esc(s.title)}</h2>${s.body}
   ${s.audio?`<div class="row" style="margin-top:16px">${audioBtn(s.audio[0],"big")} ${slowBtn(s.audio[0])}<span class="mini">${isAR()?"استمع للنطق":"Listen to the audio"}</span></div>`:""}
   <button class="btn pri lg full" style="margin-top:22px" data-action="pnext">${T("next")} ${ic("left",16)}</button>`);
 case "mcq":
  return A(`<div class="qtext">${s.q}</div>${s.say?`<div class="speaker">${audioBtn(s.say,"big")}${slowBtn(s.say)}</div>`:""}
   ${s.opts.map((o,i)=>`<button class="opt" data-pick="${i}"><span class="ob">${"ABCD"[i]||i+1}</span><span>${/^[A-Za-z' .,!?]+$/.test(o)&&o.length<40?`<span class="en">${esc(o)}</span>`:esc(o)}</span></button>`).join("")}
   <div id="pfb"></div>`);
 case "tf":
  return A(`<div class="qtext">${s.q}</div><div class="grid2" style="gap:10px">
   <button class="opt" style="justify-content:center" data-pick="0">${ic("check",18)} True</button>
   <button class="opt" style="justify-content:center" data-pick="1">${ic("x",18)} False</button></div><div id="pfb"></div>`);
 case "fill":
  return A(`<div class="qtext">${T("fillQ")}</div><div class="formula" style="direction:ltr;font-size:19px">${esc(s.s).replace("___",`<input id="pin" class="" style="width:110px;background:none;border:0;border-bottom:2px solid var(--jade);outline:0;text-align:center;font-family:var(--f-en);font-size:18px" autofocus>`)}
   </div>${hintBtn(s)}<button class="btn pri full" style="margin-top:14px" data-action="pcheck">${T("check")}</button><div id="pfb"></div>`);
 case "order":
  if(!PL.orderWords)PL.orderWords=s.words.slice();
  if(!PL.orderSel)PL.orderSel=[];
