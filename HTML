/* skill stats (measured accuracy by exercise tag) */
const SKILLS={vocab:["vocab","match"],grammar:["grammar"],listen:["listen"],spell:["spell"],trans:["trans"]};
function recordSkill(tag,ok){if(!tag)return;const d=U();d.skill[tag]=d.skill[tag]||{c:0,a:0};d.skill[tag].a++;if(ok)d.skill[tag].c++;const a=act();a.a++;if(ok)a.c++;STORE.save()}
function skillAcc(tag){const s=U().skill[tag];return(!s||s.a<3)?null:Math.round(100*s.c/s.a)}
function weakestSkill(){let w=null,v=101;Object.keys(SKILLS).forEach(k=>{const tags=SKILLS[k];let c=0,a=0;tags.forEach(t=>{const s=U().skill[t];if(s){c+=s.c;a+=s.a}});if(a>=4){const acc=100*c/a;if(acc<v){v=acc;w=k}}});return w?{k:w,acc:Math.round(v)}:null}

/* ================================================================
   AUDIO — Web Speech API wrapper (real TTS, no keys required)
================================================================ */
let VOICES=[];
function loadVoices(){if(!window.speechSynthesis)return;VOICES=speechSynthesis.getVoices().filter(v=>v.lang&&v.lang.toLowerCase().startsWith("en"))}
if(window.speechSynthesis){loadVoices();speechSynthesis.onvoiceschanged=loadVoices}
function pickVoice(lang,alt){
 if(!VOICES.length)return null;
 const pref=VOICES.filter(v=>v.lang.toLowerCase().replace("_","-").startsWith(lang));
 const list=pref.length?pref:VOICES;
 return list[(alt||0)%list.length];
}
