function missionRefresh(){
 const d=U();if(!d)return;const t=todayKey();
 if(!d.missions||d.missions.date!==t){
  const h=dayHash(t+"|"+(cur()?.id||""));
  const pool=[...MISSION_POOL];const picks=[];
  // always include the daily goal mission, pick 2 more deterministically
  picks.push(pool.find(m=>m.id==="xpgoal"));
  const rest=pool.filter(m=>m.id!=="xpgoal");
  for(let i=0;i<2;i++)picks.push(rest.splice(h%rest.length,1)[0]);
  d.missions={date:t,list:picks.map(m=>({id:m.id,g:m.id==="xpgoal"?(cur()?.prefs?.goal||30):m.g,xp:m.xp,granted:false}))};
 }
 const a=act();if(!a)return;
 let changed=false;
 d.missions.list.forEach(m=>{
  const val=m.id==="xpgoal"?a.xp:(a[m.id==="lesson1"?"lessons":m.id==="review5"?"reviews":m.id==="audio10"?"audio":"listen"]||0);
  m.prog=Math.min(val,m.g);
  if(m.prog>=m.g&&!m.granted){m.granted=true;changed=true;
   d.xpLedger.push({id:uid4(),at:Date.now(),amount:m.xp,reason:"mission:"+m.id});a.xp+=m.xp;
   toast(T("missionDone"));}
 });
 if(changed){STORE.save();checkAch()}
}

