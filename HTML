  case "glvl":GQ.lvl=GQ.lvl===t.dataset.v?"":t.dataset.v;render();break;
  case "gfav":{const d=U();const id=t.dataset.id;d.grammarFav=d.grammarFav.includes(id)?d.grammarFav.filter(x=>x!==id):[...d.grammarFav,id];STORE.save();toast(d.grammarFav.includes(id)?T("saveF"):T("removedF"));render();break}
  case "dplay":{const dg=DIALOGS.find(d=>d.id===t.dataset.id);if(DPLAY.on){DPLAY.on=false;if($("#dplay"))$("#dplay").innerHTML=ic("play",16)+" "+T("playAll");window.speechSynthesis?.cancel()}else playDialogue(dg);break}
  case "ptab":PTAB=t.dataset.k;render();break;
  case "sayabc":say(t.dataset.l).then(()=>setTimeout(()=>say(t.dataset.w),200));break;
  case "discrim":startDiscrim();break;
  case "spellstart":startSpell();break;
  case "spellcheck":checkSpell();break;
  case "rec":toggleRec();break;
  case "battle":startBattle(t.dataset.kind);break;
  case "srs":{vocabRate(t.dataset.id,+t.dataset.r);const a=act();a.reviews++;const d=U();
   const reviewXPToday=d.xpLedger.filter(x=>x.reason==="review"&&new Date(x.at).toDateString()===new Date().toDateString()).reduce((s,x)=>s+x.amount,0);
   if(reviewXPToday<15)grantXP(1,"review");
   STORE.save();SRS.i++;SRS.shown=false;renderSRS();break}
  case "srs-show":SRS.shown=true;renderSRS();break;
  case "amode":renderAuth(t.dataset.v);break;
  case "alogin":doLogin();break;
  case "aregister":doRegister();break;
  case "guest":guestLogin();break;
  case "google":toast(T("googleNote"));break;
  case "logout":logout();break;
  case "delacc":if(confirm(T("deleteQ")+"\n"+T("delWarn"))){const u=cur();delete DB.data[u.id];DB.users=DB.users.filter(x=>x.id!==u.id);delete DB.sessions[TOKEN];STORE.save();TOKEN=null;localStorage.removeItem(STORE.tkey);location.hash="#/";render()}break;
  case "export":{const u=cur();const data={user:{name:u.name,email:u.email,createdAt:u.createdAt,prefs:u.prefs},progress:U()};const blob=new Blob([JSON.stringify(data,null,2)],{type:"application/json"});const aEl=document.createElement("a");aEl.href=URL.createObjectURL(blob);aEl.download="lisan-export.json";aEl.click();break}
  case "onbnext":ONB.step=Math.min(3,ONB.step+1);render();break;
  case "onbback":ONB.step=Math.max(0,ONB.step-1);render();break;
  case "onbdone":onbFinish();break;
  case "more":{const host=$("#overlayhost");
   const items=[["tests",T("tests"),"target"],["chal",T("chal"),"zap"],["board",T("board"),"trophy"],["grammar",T("grammar"),"edit"],["sent",T("sent"),"msg"],["prof",T("prof"),"chart"],["settings",T("set"),"sliders"]];
   host.innerHTML=`<div id="sheetback" class="show" data-action="closesheet"></div><div id="sheet"><div style="width:40px;height:4px;border-radius:4px;background:var(--line);margin:0 auto 14px"></div>
   <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:10px">${items.map(([r,l,i])=>`<button style="display:flex;flex-direction:column;align-items:center;gap:6px;padding:12px 4px;font-size:11.5px;font-weight:600;color:var(--ink2)" data-nav="#/${r}">${ic(i,21)}<span>${l}</span></button>`).join("")}</div>
   <button class="btn sec full" style="margin-top:10px" data-action="logout">${ic("logout",15)} ${T("signout")}</button></div>`;
   $("#sheetback").onclick=()=>host.innerHTML="";break}
  case "closesheet":$("#overlayhost").innerHTML="";break;
  case "train-skill":{const k=t.dataset.k;if(k==="listen"){PTAB="sounds";location.hash="#/pron"}else if(k==="spell"){PTAB="spell";location.hash="#/pron"}else if(k==="grammar")location.hash="#/grammar";else{VQ.tab="review";location.hash="#/vocab"}render();break}
  case "say-good":{const inp=$(t.dataset.sayGood);if(inp&&inp.value)say(inp.value);break}
 }
 // word-order interaction
 if(t.dataset.ord!==undefined){PL.orderUsed=PL.orderUsed||[];PL.orderUsed.push(+t.dataset.ord);PL.orderSel=PL.orderSel||[];PL.orderSel.push(PL.orderWords[+t.dataset.ord]);renderPlayer();return}
 if(t.dataset.unord!==undefined){const i=+t.dataset.unord;const w=PL.orderSel.splice(i,1)[0];const idx=PL.orderWords.indexOf(w,PL.orderUsed.findIndex?0:0);
  // remove one occurrence from used
  const wIdx=PL.orderWords.findIndex((x,xi)=>x===w&&PL.orderUsed.includes(xi)&&!PL.orderSel.includes(x)||x===w&&PL.orderUsed.includes(xi));
  let rem=PL.orderUsed.findIndex(xi=>PL.orderWords[xi]===w);
  if(rem>-1)PL.orderUsed.splice(rem,1);
  renderPlayer();return}
 // matching interaction
 if(t.dataset.ml!==undefined||t.dataset.mr!==undefined){
  const side=t.dataset.ml!==undefined?"L":"R",i=+(t.dataset.ml??t.dataset.mr);
  if(PL.matchLock?.includes(i))return;
  if(!PL.matchSel){PL.matchSel={side,i};renderPlayer();return}
  if(PL.matchSel.side===side){PL.matchSel={side,i};renderPlayer();return}
  if(PL.matchSel.i===i){PL.matchLock=[...PL.matchLock,i];PL.matchSel=null;PL.matchDone++;
   if(PL.matchDone===PL.steps[PL.i].pairs.length){setTimeout(()=>pgrade(PL.matchErr===0,``,` `),300)}else renderPlayer();
  }else{PL.matchErr++;t.classList.add("bad","shake");const s=PL.steps[PL.i];recordSkill(s.tag,false);
   setTimeout(()=>{PL.matchSel=null;renderPlayer()},500)}
  return}
});
document.addEventListener("keydown",e=>{
 if(e.key==="Escape"){closeSearch();$("#overlayhost").innerHTML="";$("#notifpanel")?.classList.remove("show")}
 if((e.ctrlKey||e.metaKey)&&e.key==="k"){e.preventDefault();openSearch()}
});
document.addEventListener("input",e=>{const t=e.target;if(t.dataset?.sel)return});
window.addEventListener("hashchange",()=>{if(!$("#playerhost").innerHTML)render()});
document.addEventListener("change",e=>{const t=e.target;if(t.dataset?.sel==="vlvl"){VQ.lvl=t.value;render()}if(t.dataset?.sel==="vcat"){VQ.cat=t.value;render()}});
/* study-time heartbeat: 1 min of visible activity */
setInterval(()=>{if(AUTHED()&&document.visibilityState==="visible"){const a=act();a.min=(a.min||0)+1;STORE.save()}},60000);

/* init */
(function init(){
 STORE.load();missionRefresh();
 const u=cur();if(u){UI=u.prefs.lang||UI}
 document.documentElement.dataset.theme=localStorage.getItem("lisan_theme")||"light";
 render();
})();
</script>
