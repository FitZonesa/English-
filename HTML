let DB=null,TOKEN=null,UNOTIF={};
const STORE={
 key:"lisan_db_v1", tkey:"lisan_token",
 load(){try{DB=JSON.parse(localStorage.getItem(this.key))}catch(e){DB=null} if(!DB||!DB.users)DB={users:[],data:{},sessions:{}};TOKEN=localStorage.getItem(this.tkey)},
 save(){localStorage.setItem(this.key,JSON.stringify(DB))},
};
const AUTHED=()=>TOKEN&&DB.sessions[TOKEN]&&DB.sessions[TOKEN].exp>Date.now();
const cur=()=>AUTHED()?DB.users.find(u=>u.id===DB.sessions[TOKEN].uid):null;
function U(){const u=cur();if(!u)return null; if(!DB.data[u.id])DB.data[u.id]=newUserData(); return DB.data[u.id]}
function newUserData(){return{progress:{},vocab:{},grammarFav:[],xpLedger:[],attempts:[],streak:{cur:0,best:0,last:null,dates:[]},activity:{},missions:{date:null,list:[]},achievements:[],skill:{},mistakes:{},stats:{audioPlays:0,dialogues:0},placement:null}}
async function hashPass(pw,salt){
 try{const buf=await crypto.subtle.digest("SHA-256",new TextEncoder().encode(salt+":"+pw));return[...new Uint8Array(buf)].map(b=>b.toString(16).padStart(2,"0")).join("")}
 catch(e){let h=5381;for(const c of salt+":"+pw)h=((h<<5)+h+c.charCodeAt(0))>>>0;return "f"+h.toString(16)}}

/* activity helpers */
function act(day=todayKey()){const d=U();if(!d)return null;d.activity[day]=d.activity[day]||{xp:0,lessons:0,reviews:0,listen:0,audio:0,min:0,c:0,a:0};return d.activity[day]}
function bump(k,n=1){const a=act();if(!a)return;a[k]=(a[k]||0)+n;STORE.save();missionRefresh()}

