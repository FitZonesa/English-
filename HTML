================================================================ */
const MISTAKE_RULES=[
 {re:/\b(he|she|it)\s+(go|come|eat|drink|work|play|study|live|like|want|need|know)\b/i,fix:m=>m.replace(/\b(go|come|eat|drink|work|play|study|live|like|want|need|know)\b/i,w=>w+"s"),why:"الغائب المفرد (he/she/it) يحتاج s على الفعل في المضارع البسيط."},
 {re:/\bcan\s+to\b/i,fix:m=>m.replace(/\bto\s+/i,""),why:"بعد can يأتي الفعل المجرد بلا to."},
 {re:/\bmore\s+(better|bigger|smaller|easier|faster|older|cheaper)\b/i,fix:m=>m.replace(/more\s+/i,""),why:"لا نجمع more مع صيغة er — صيغة واحدة تكفي."},
 {re:/\bthere\s+is\s+(two|three|four|five|six|seven|eight|nine|ten|many|some\s+\w+s|\w+s)\b/i,fix:m=>m.replace(/there\s+is/i,"There are"),why:"الجمع بعد There ← There are."},
 {re:/\bi\s+have\s+(.+)years?\b/i,fix:m=>m.replace(/i\s+have\s+(.+)\s+years?/i,"I am $1 years old"),why:"العمر يُقال بفعل be: I am 20 years old."},
 {re:/\bhe\s+don't\b|\bhe\s+dont\b/i,fix:m=>m.replace(/he\s+don'?t/i,"He doesn't"),why:"الغائب المفرد ← doesn't."},
 {re:/\bi\s+am\s+agree\b/i,fix:m=>m.replace(/i\s+am\s+agree/i,"I agree"),why:"agree فعل كامل — لا يحتاج am."},
 {re:/\b(informations|advices|knowledges|furnitures|luggages)\b/i,fix:m=>m.replace(/s\b/,"",),why:"هذا اسم غير معدود — لا يُجمع."},
 {re:/\bdid\s+(you|he|she|they|we|i)\s+\w*(went|ate|saw|came|took|made|bought|found|had)\b/i,fix:m=>m.replace(/\b(went|ate|saw|came|took|made|bought|found|had)\b/i,"the base form"),why:"بعد did يعود الفعل مجردًا: Did you go?"},
 {re:/\bi\s+have\s+\w+\w*ed\s+(yesterday|last\s+(week|month|year|night)|ago)\b/i,fix:m=>m.replace(/\bhave\b/i,"—"),why:"مع وقت ماضٍ محدد (yesterday/ago) نستخدم الماضي البسيط لا المضارع التام."},
 {re:/\bif\s+\w+\s+will\b/i,fix:m=>m.replace(/\bwill\s+/i,""),why:"لا نستخدم will بعد if في الشرط الأول."},
];
function tutorReply(msg){
 const m=msg.trim();
 // 1) grammar correction on English sentences
 if(/[a-z]/i.test(m)&&m.split(/\s+/).length>2){
  for(const r of MISTAKE_RULES){if(r.re.test(m)){
   return {html:`<b>${isAR()?"تصحيح:":"Correction:"}</b><div class="formula" style="margin:8px 0;font-size:14px">${esc(r.fix(m))}</div><small>${r.why}</small>`}}}
  return {html:isAR()?"لم أجد خطأً في قواعدك الشائعة — جملتك تبدو سليمة من ناحية الأنماط التي أرصدها. للمزيد راجع قسم القواعد.":"I didn't detect any of the common mistakes I track — your sentence looks fine pattern-wise. Check the Grammar section for more."};
 }
 // 2) grammar topic lookup
 const g=GRAMMAR.find(x=>m.includes(x.ar.split(" ")[0].slice(0,4))||m.toLowerCase().includes(x.en.toLowerCase().split(" ")[0]));
 if(g&&m.length>2)return {html:`<b>${esc(g.ar)} — ${esc(g.en)} (${g.lvl})</b><div class="formula" style="margin:8px 0;font-size:13px">${esc(g.formula)}</div><small>${esc(g.explain)}</small>`,nav:"#/grammar/"+g.id};
 // 3) vocab lookup
 const v=VOCAB.find(x=>m.toLowerCase().includes(x.w.toLowerCase()));
 if(v)return {html:`<b class="en">${esc(v.w)}</b> — <b>${esc(v.ar)}</b><div class="mini" style="margin:4px 0">${esc(v.ipa)} · ${esc(v.pos)} · ${v.lvl}</div><div class="mini en" style="direction:ltr;text-align:start">${esc(v.ex)}</div>`,nav:"#/vocab"};
 return {html:isAR()?"أسئلة مقترحة: «شرح المضارق التام»، «معنى beautiful»، أو اكتب جملة إنجليزية لأصححها.":"Try: 'present perfect', 'meaning of beautiful', or type an English sentence for me to check."};
}
