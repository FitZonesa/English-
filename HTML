 case "listen":
  return A(`<div class="qtext">${T("listenQ")}</div><div class="speaker">${audioBtn(s.say,"big")}${slowBtn(s.say)}</div>
   <div class="qtext" style="font-size:16px">${s.q}</div>
   ${s.opts.map((o,i)=>`<button class="opt" data-pick="${i}"><span class="ob">${"ABCD"[i]}</span><span>${/^[A-Za-z' .,!?]+$/.test(o)?`<span class="en">${esc(o)}</span>`:esc(o)}</span></button>`).join("")}<div id="pfb"></div>`);
