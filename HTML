<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>لِسان · LISAN — تعلّم الإنجليزية</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700&family=Sora:wght@400;600;700;800&display=swap" rel="stylesheet">
<style>
/* ============ LISAN DESIGN SYSTEM ============ */
:root{
  --bg:#F5F2EA; --panel:#FFFFFF; --panel2:#FAF8F1; --panel3:#EFECE2;
  --ink:#22322B; --ink2:#5A6A61; --ink3:#96A296;
  --line:rgba(34,50,43,.13); --line2:rgba(34,50,43,.07);
  --jade:#0E7A5C; --jade-ink:#0A5B44; --jade-soft:#E2EFE8; --jade-line:#BED8CB;
  --amber:#C98A18; --amber-soft:#F7EDD6; --red:#C04A38; --red-soft:#F8E7E2; --red-line:#E4C3BB;
  --r:14px; --r2:10px;
  --sh:0 1px 2px rgba(34,50,43,.05), 0 10px 28px -16px rgba(34,50,43,.22);
  --sh2:0 4px 14px -6px rgba(34,50,43,.25);
  --f-ui:'IBM Plex Sans Arabic',system-ui,sans-serif; --f-en:'Sora',sans-serif;
}
[data-theme="dark"]{
  --bg:#0F1713; --panel:#18231D; --panel2:#1C2A22; --panel3:#24332B;
  --ink:#E9EFE8; --ink2:#A8B5AA; --ink3:#727F74;
  --line:rgba(233,239,232,.14); --line2:rgba(233,239,232,.07);
  --jade:#43BE92; --jade-ink:#8BDDBD; --jade-soft:rgba(67,190,146,.13); --jade-line:rgba(67,190,146,.35);
  --amber:#E2A63D; --amber-soft:rgba(226,166,61,.14); --red:#E07158; --red-soft:rgba(224,113,88,.13); --red-line:rgba(224,113,88,.35);
  --sh:0 1px 2px rgba(0,0,0,.35), 0 12px 32px -16px rgba(0,0,0,.6);
  --sh2:0 6px 18px -8px rgba(0,0,0,.55);
}
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%}
body{font-family:var(--f-ui);background:var(--bg);color:var(--ink);font-size:15px;line-height:1.65;overflow:hidden}
html[dir="ltr"] body{font-size:15px}
button{font-family:inherit;font-size:inherit;color:inherit;background:none;border:0;cursor:pointer}
input,select,textarea{font-family:inherit;font-size:inherit;color:inherit}
.en{font-family:var(--f-en);direction:ltr;display:inline-block}
.num{font-family:var(--f-en);font-variant-numeric:tabular-nums;direction:ltr;display:inline-block}
::-webkit-scrollbar{width:8px;height:8px}::-webkit-scrollbar-thumb{background:var(--line);border-radius:8px}::-webkit-scrollbar-track{background:transparent}
:focus-visible{outline:2px solid var(--jade);outline-offset:2px;border-radius:4px}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}

/* ============ SHELL ============ */
#app{display:grid;grid-template-columns:250px 1fr;grid-template-rows:64px 1fr;height:100dvh}
#sidebar{grid-row:1/3;display:flex;flex-direction:column;border-inline-end:1px solid var(--line);background:var(--panel);padding:0 14px 14px}
#brandrow{height:64px;display:flex;align-items:center;gap:10px;padding-inline-start:6px}
.logomark{width:34px;height:34px;border-radius:9px;background:var(--jade);display:grid;place-items:center;flex:none}
.brandname{font-weight:700;font-size:17px;letter-spacing:.3px}
.brandname small{display:block;font-size:10px;color:var(--ink3);font-weight:500;letter-spacing:1.5px}
#nav{margin-top:10px;display:flex;flex-direction:column;gap:2px;overflow-y:auto;flex:1}
.navitem{display:flex;align-items:center;gap:11px;padding:9px 12px;border-radius:var(--r2);color:var(--ink2);font-weight:500;position:relative;transition:background .15s,color .15s;text-align:start;width:100%}
.navitem svg{flex:none}
.navitem:hover{background:var(--panel2);color:var(--ink)}
.navitem.on{background:var(--jade-soft);color:var(--jade-ink);font-weight:600}
.navitem.on::before{content:"";position:absolute;inset-inline-start:-14px;top:8px;bottom:8px;width:3px;border-radius:3px;background:var(--jade)}
.navsec{font-size:11px;color:var(--ink3);font-weight:600;letter-spacing:.8px;padding:14px 12px 5px}
#userchip{display:flex;align-items:center;gap:10px;padding:10px;border:1px solid var(--line);border-radius:var(--r);background:var(--panel2);width:100%;margin-top:10px}
#userchip:hover{border-color:var(--jade-line)}
.avatar{width:36px;height:36px;border-radius:50%;background:var(--jade-soft);color:var(--jade-ink);display:grid;place-items:center;font-weight:700;flex:none;font-family:var(--f-en)}
#topbar{display:flex;align-items:center;gap:12px;padding:0 22px;border-bottom:1px solid var(--line);background:var(--panel)}
#crumbs{min-width:0;display:flex;flex-direction:column;justify-content:center}
#crumbs b{font-size:16px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#crumbs span{font-size:11.5px;color:var(--ink3);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.tspacer{flex:1}
#searchbox{display:flex;align-items:center;gap:8px;background:var(--panel2);border:1px solid var(--line);border-radius:10px;padding:7px 12px;width:250px;color:var(--ink3)}
#searchbox input{background:none;border:0;outline:0;flex:1;color:var(--ink);font-size:13.5px;min-width:0}
.pill{display:flex;align-items:center;gap:6px;border:1px solid var(--line);border-radius:999px;padding:5px 12px;font-weight:600;font-size:13px;background:var(--panel)}
.pill .num{font-size:14px}
.iconbtn{width:38px;height:38px;border-radius:10px;display:grid;place-items:center;color:var(--ink2);position:relative;flex:none}
.iconbtn:hover{background:var(--panel2);color:var(--ink)}
.dot{position:absolute;top:7px;inset-inline-end:7px;width:7px;height:7px;border-radius:50%;background:var(--red)}
#main{overflow-y:auto;overflow-x:hidden;padding:26px 26px 60px;position:relative}
.wrap{max-width:1060px;margin:0 auto}
#bottomnav{display:none}

/* mobile */
@media(max-width:940px){
  #app{grid-template-columns:1fr;grid-template-rows:64px 1fr}
  #sidebar{display:none}
  #searchbox{display:none}
  #main{padding:16px 16px 92px}
  #bottomnav{display:flex;position:fixed;bottom:0;left:0;right:0;height:calc(62px + env(safe-area-inset-bottom));padding-bottom:env(safe-area-inset-bottom);background:var(--panel);border-top:1px solid var(--line);z-index:40}
  .bnitem{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;font-size:10.5px;color:var(--ink3);font-weight:600}
  .bnitem.on{color:var(--jade-ink)}
}

/* ============ COMPONENTS ============ */
.card{background:var(--panel);border:1px solid var(--line);border-radius:var(--r);padding:18px}
.card.pad0{padding:0;overflow:hidden}
.hcard{background:var(--panel);border:1px solid var(--line);border-radius:var(--r);padding:22px;box-shadow:var(--sh)}
.eyebrow{font-size:11.5px;font-weight:700;letter-spacing:1px;color:var(--jade-ink);text-transform:uppercase}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;border-radius:11px;padding:10px 20px;font-weight:700;font-size:14.5px;transition:transform .12s,box-shadow .15s,background .15s;border:1px solid transparent}
.btn:active{transform:scale(.97)}
.btn.pri{background:var(--jade);color:#fff}
[data-theme="dark"] .btn.pri{color:#0C211A}
.btn.pri:hover{box-shadow:var(--sh2)}
.btn.sec{background:var(--panel2);border-color:var(--line);color:var(--ink)}
.btn.sec:hover{border-color:var(--jade-line)}
.btn.ghost{color:var(--ink2)}.btn.ghost:hover{background:var(--panel2);color:var(--ink)}
.btn.warn{background:var(--red-soft);color:var(--red);border-color:var(--red-line)}
.btn.sm{padding:7px 14px;font-size:13px;border-radius:9px}
.btn.lg{padding:13px 26px;font-size:16px}
.btn[disabled]{opacity:.55;cursor:not-allowed;transform:none!important}
.btn.full{width:100%}
.chip{display:inline-flex;align-items:center;gap:6px;border:1px solid var(--line);border-radius:999px;padding:4px 13px;font-size:12.5px;font-weight:600;color:var(--ink2);cursor:pointer;background:var(--panel);transition:all .15s}
.chip:hover{border-color:var(--jade-line)}
.chip.on{background:var(--jade-soft);border-color:var(--jade-line);color:var(--jade-ink)}
.tag{display:inline-flex;align-items:center;gap:4px;font-size:11px;font-weight:700;padding:2px 9px;border-radius:6px;background:var(--panel3);color:var(--ink2)}
.tag.j{background:var(--jade-soft);color:var(--jade-ink)}
.tag.a{background:var(--amber-soft);color:var(--amber)}
.tag.r{background:var(--red-soft);color:var(--red)}
.input{width:100%;background:var(--panel2);border:1px solid var(--line);border-radius:11px;padding:11px 14px;outline:0;transition:border .15s}
.input:focus{border-color:var(--jade)}
label.f{display:block;font-size:12.5px;font-weight:700;color:var(--ink2);margin:14px 0 6px}
.divider{height:1px;background:var(--line2);margin:16px 0}
.progress{height:7px;background:var(--panel3);border-radius:99px;overflow:hidden}
.progress i{display:block;height:100%;background:var(--jade);border-radius:99px;transition:width .5s cubic-bezier(.2,.8,.2,1)}
.progress.a i{background:var(--amber)}
.abtn{width:34px;height:34px;border-radius:9px;display:inline-grid;place-items:center;background:var(--jade-soft);color:var(--jade-ink);flex:none;transition:background .15s}
.abtn:hover{background:var(--jade);color:#fff}
[data-theme="dark"] .abtn:hover{color:#0C211A}
.abtn.big{width:52px;height:52px;border-radius:14px}
.abtn.slow{background:var(--panel2);color:var(--ink2);width:28px;height:28px}
.headrow{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:16px}
.headrow h1{font-size:21px;font-weight:700;flex:1;min-width:180px}
.backlink{display:inline-flex;align-items:center;gap:6px;color:var(--ink2);font-weight:600;font-size:13.5px;padding:6px 10px;border-radius:8px}
.backlink:hover{background:var(--panel2);color:var(--ink)}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.dash{display:grid;grid-template-columns:1.55fr 1fr;gap:18px;align-items:start}
@media(max-width:900px){.dash,.grid2,.grid3{grid-template-columns:1fr}}
.stack{display:flex;flex-direction:column;gap:18px}
.row{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.stat{display:flex;align-items:center;gap:12px}
.stat .v{font-family:var(--f-en);font-size:22px;font-weight:800;line-height:1.1}
.stat .k{font-size:12px;color:var(--ink3);font-weight:600}
.abtn.pulse{animation:pul 1.8s infinite}
@keyframes pul{0%,100%{box-shadow:0 0 0 0 rgba(14,122,92,.35)}50%{box-shadow:0 0 0 9px rgba(14,122,92,0)}}
.shake{animation:shk .35s}
@keyframes shk{20%{transform:translateX(-5px)}40%{transform:translateX(5px)}60%{transform:translateX(-3px)}80%{transform:translateX(3px)}}
.pop{animation:pop .3s cubic-bezier(.2,1.6,.4,1)}
@keyframes pop{from{transform:scale(.8);opacity:0}}

/* path nodes */
.node{display:flex;align-items:center;gap:13px;padding:11px 14px;border-radius:var(--r2);width:100%;text-align:start;transition:background .15s}
.node:hover{background:var(--panel2)}
.node .nd{width:36px;height:36px;border-radius:12px;display:grid;place-items:center;flex:none;border:1.5px solid var(--line);background:var(--panel);color:var(--ink2)}
.node.done .nd{background:var(--jade);border-color:var(--jade);color:#fff}
[data-theme="dark"] .node.done .nd{color:#0C211A}
.node.cur .nd{border-color:var(--jade);color:var(--jade-ink);background:var(--jade-soft)}
.node.lock{opacity:.45}
.node .nt{flex:1;min-width:0}.node .nt b{display:block;font-size:14px}
.node .nt small{color:var(--ink3);font-size:12px}
.unithead{display:flex;align-items:center;gap:10px;margin:18px 0 6px;font-weight:700;color:var(--ink2)}
.unitline{height:2px;flex:1;background:var(--line)}
.lvlbadge{width:52px;height:52px;border-radius:15px;display:grid;place-items:center;font-family:var(--f-en);font-weight:800;font-size:17px;flex:none;border:2px solid var(--jade-line);background:var(--jade-soft);color:var(--jade-ink)}
.lvlbadge.lock{border-color:var(--line);background:var(--panel2);color:var(--ink3)}

/* lesson player */
#player{position:fixed;inset:0;background:var(--bg);z-index:100;display:flex;flex-direction:column}
#player .phead{height:64px;display:flex;align-items:center;gap:14px;padding:0 20px;background:var(--panel);border-bottom:1px solid var(--line)}
#psegs{flex:1;display:flex;gap:4px;max-width:520px}
#psegs i{flex:1;height:6px;border-radius:6px;background:var(--panel3)}
#psegs i.d{background:var(--jade)}
#psegs i.x{background:var(--red)}
#pbody{flex:1;overflow-y:auto;display:flex;flex-direction:column;align-items:center;padding:30px 18px 40px}
.pcard{width:100%;max-width:660px}
.qtext{font-size:19px;font-weight:700;margin-bottom:8px;line-height:1.55}
.qsub{color:var(--ink2);font-size:14px;margin-bottom:18px}
.opt{display:flex;align-items:center;gap:12px;width:100%;text-align:start;padding:14px 16px;border:1.5px solid var(--line);border-radius:13px;margin-bottom:10px;background:var(--panel);font-size:16px;transition:all .15s}
.opt:hover{border-color:var(--jade-line)}
.opt .ob{width:26px;height:26px;border-radius:8px;border:1.5px solid var(--line);display:grid;place-items:center;font-family:var(--f-en);font-size:12px;font-weight:700;flex:none;color:var(--ink3)}
.opt.sel{border-color:var(--jade);background:var(--jade-soft)}
.opt.ok{border-color:var(--jade);background:var(--jade-soft)}
.opt.ok .ob{background:var(--jade);color:#fff;border-color:var(--jade)}
.opt.no{border-color:var(--red);background:var(--red-soft)}
.opt.no .ob{background:var(--red);color:#fff;border-color:var(--red)}
.wordinput{width:100%;border:1.5px solid var(--line);background:var(--panel);border-radius:13px;padding:15px 18px;font-size:17px;outline:0;font-family:var(--f-en);direction:ltr;text-align:center}
.wordinput:focus{border-color:var(--jade)}
.chipline{min-height:58px;border:1.5px dashed var(--line);border-radius:13px;padding:8px;display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-bottom:14px}
.wchip{padding:7px 14px;border-radius:9px;background:var(--panel2);border:1px solid var(--line);font-family:var(--f-en);font-size:15px;cursor:pointer;transition:all .12s}
.wchip:hover{border-color:var(--jade-line)}
.wchip.used{opacity:.25;pointer-events:none}
.srcchips{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:8px}
.fb{border-radius:13px;padding:15px 18px;margin-top:14px;display:flex;gap:12px;align-items:flex-start;animation:pop .25s}
.fb.ok{background:var(--jade-soft);border:1px solid var(--jade-line)}
.fb.no{background:var(--red-soft);border:1px solid var(--red-line)}
.fb b{display:block;font-size:14.5px}
.fb small{display:block;color:var(--ink2);font-size:13px;margin-top:3px}
.matchcol{display:flex;flex-direction:column;gap:8px;flex:1}
.mitem{padding:12px;border:1.5px solid var(--line);border-radius:11px;background:var(--panel);font-size:15px;transition:all .15s;min-height:46px}
.mitem.sel{border-color:var(--jade);background:var(--jade-soft)}
.mitem.lock{background:var(--jade-soft);border-color:var(--jade-line);color:var(--jade-ink);pointer-events:none;opacity:.9}
.mitem.bad{border-color:var(--red);background:var(--red-soft)}
.speaker{display:flex;align-items:center;gap:10px;margin-bottom:16px}
.dline{display:flex;gap:12px;padding:12px 14px;border-radius:12px;border:1px solid var(--line);margin-bottom:10px;background:var(--panel);align-items:flex-start}
.dline.hl{border-color:var(--jade);background:var(--jade-soft)}
.spk{width:30px;height:30px;border-radius:9px;display:grid;place-items:center;font-weight:800;font-size:12px;flex:none;font-family:var(--f-en)}
.spk.s0{background:var(--jade-soft);color:var(--jade-ink)}
.spk.s1{background:var(--amber-soft);color:var(--amber)}

/* misc */
.toast{position:fixed;bottom:86px;left:50%;transform:translateX(-50%) translateY(20px);background:var(--ink);color:var(--bg);padding:11px 22px;border-radius:12px;font-weight:600;font-size:14px;z-index:300;opacity:0;transition:all .3s;pointer-events:none;max-width:88vw;text-align:center;box-shadow:var(--sh2)}
.toast.show{opacity:1;transform:translateX(-50%) translateY(0)}
#modalback{position:fixed;inset:0;background:rgba(15,25,20,.5);z-index:200;display:none;align-items:center;justify-content:center;padding:18px}
#modalback.show{display:flex}
.modal{background:var(--panel);border-radius:18px;padding:26px;max-width:480px;width:100%;box-shadow:var(--sh2);animation:pop .25s;max-height:86vh;overflow-y:auto}
#sheetback{position:fixed;inset:0;background:rgba(15,25,20,.5);z-index:200;display:none}
#sheetback.show{display:block}
#sheet{position:fixed;bottom:0;left:0;right:0;background:var(--panel);border-radius:20px 20px 0 0;padding:14px 18px calc(24px + env(safe-area-inset-bottom));z-index:201;transform:translateY(100%);transition:transform .3s cubic-bezier(.2,.8,.2,1)}
#sheetback.show + #sheet{transform:translateY(0)}
#notifpanel{position:absolute;top:56px;inset-inline-end:0;width:330px;max-width:calc(100vw - 32px);background:var(--panel);border:1px solid var(--line);border-radius:14px;box-shadow:var(--sh2);padding:8px;display:none;z-index:60;max-height:60vh;overflow-y:auto}
#notifpanel.show{display:block}
.notifrow{display:flex;gap:11px;padding:11px;border-radius:10px;align-items:flex-start}
.notifrow:hover{background:var(--panel2)}
.notifrow .ic{width:34px;height:34px;border-radius:9px;display:grid;place-items:center;flex:none}
.flame{color:var(--amber)}
.xpflash{position:fixed;top:80px;inset-inline-end:40px;font-family:var(--f-en);font-weight:800;color:var(--amber);font-size:20px;z-index:150;pointer-events:none;animation:xpf 1.2s forwards}
@keyframes xpf{0%{opacity:0;transform:translateY(10px)}20%{opacity:1}100%{opacity:0;transform:translateY(-26px)}}
.tabs{display:flex;gap:4px;background:var(--panel2);border:1px solid var(--line);border-radius:11px;padding:4px;width:max-content;max-width:100%;overflow-x:auto}
.tab{padding:7px 16px;border-radius:8px;font-weight:600;font-size:13.5px;color:var(--ink2);white-space:nowrap}
.tab.on{background:var(--panel);color:var(--jade-ink);box-shadow:var(--sh)}
.vocabrow{display:flex;align-items:center;gap:13px;padding:14px 16px;border-bottom:1px solid var(--line2);cursor:pointer;transition:background .15s}
.vocabrow:hover{background:var(--panel2)}
.vocabrow:last-child{border-bottom:0}
.vw{font-family:var(--f-en);font-weight:700;font-size:16.5px;min-width:110px;direction:ltr}
.vocabopen{background:var(--panel2);border-bottom:1px solid var(--line2);padding:14px 18px}
.mission{display:flex;align-items:center;gap:12px;padding:11px 0;border-bottom:1px solid var(--line2)}
.mission:last-child{border-bottom:0}
.barchart{display:flex;align-items:flex-end;gap:8px;height:120px;padding-top:8px}
.bcol{flex:1;display:flex;flex-direction:column;align-items:center;gap:6px;height:100%;justify-content:flex-end}
.bcol .b{width:100%;max-width:34px;background:var(--jade-soft);border:1px solid var(--jade-line);border-radius:7px 7px 3px 3px;position:relative;transition:height .5s}
.bcol.today .b{background:var(--jade)}
.bcol .bl{font-size:10.5px;color:var(--ink3);font-weight:600}
.bcol .bv{font-size:10px;color:var(--ink2);font-family:var(--f-en)}
.achrow{display:flex;gap:14px;overflow-x:auto;padding:4px 2px 10px;scrollbar-width:thin}
.ach{flex:none;width:96px;text-align:center}
.ach .am{width:56px;height:56px;margin:0 auto 7px;border-radius:16px;display:grid;place-items:center;background:var(--amber-soft);color:var(--amber)}
.ach.lock{opacity:.4;filter:grayscale(.7)}
.ach b{font-size:11.5px;display:block;font-weight:600;line-height:1.4}
.gitem{display:flex;align-items:center;gap:12px;padding:14px 16px;border-bottom:1px solid var(--line2);width:100%;text-align:start;transition:background .15s}
.gitem:hover{background:var(--panel2)}
.gitem:last-child{border-bottom:0}
.exrow{display:flex;align-items:center;gap:10px;padding:10px 12px;border:1px solid var(--line);border-radius:11px;margin-bottom:8px;background:var(--panel2)}
.exrow .en{font-weight:600}
.exrow .ar{color:var(--ink2);font-size:13px;flex:1}
