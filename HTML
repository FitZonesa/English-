 if(s.t==="fill"||s.t==="trans"){ok=s.a.some(a=>norm(a)===val);correct=`<span class="en">${esc(s.a[0])}</span>`}
 else if(s.t==="spell"){ok=val===norm(s.word);correct=`<span class="en">${esc(s.word)}</span>`}
 pgrade(ok,correct,s.why||"");
}
function pcheckOrder(){
 const s=PL.steps[PL.i];const val=PL.orderSel.join(" ");
