function renderPlayer(){
 const host=$("#playerhost");
 if(!PL){host.innerHTML="";return}
 const segs=PL.steps.map((s,i)=>`<i class="${i<PL.i?(PL.stepOk?.[i]===false?"x":"d"):""}"></i>`).join("");
