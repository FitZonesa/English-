}
function hintBtn(s){return s.hint?`<button class="btn ghost sm" data-action="phint">${ic("sparkle",14)} ${T("hint")}: ${esc(s.hint)}</button>`:""}
function shuffle(a){const r=[...a];for(let i=r.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[r[i],r[j]]=[r[j],r[i]]}return r}
function pgrade(ok,correctHTML,why){
 if(PL.answered)return;PL.answered=true;
 PL.stepOk=PL.stepOk||{};PL.stepOk[PL.i]=ok;
 recordSkill(PL.steps[PL.i].tag,ok);
 if(PL.steps[PL.i].topic)U().mistakes[PL.steps[PL.i].topic]=(U().mistakes[PL.steps[PL.i].topic]||0)+(ok?0:1);
 if(ok){PL.correct++;PL.combo++;PL.maxCombo=Math.max(PL.maxCombo,PL.combo)}
 else{PL.wrong++;PL.combo=0}
 const fb=$("#pfb");if(fb)fb.innerHTML=`<div class="fb ${ok?"ok":"no"}">${ic(ok?"check":"x",18)}<div><b>${ok?T("correct"):T("wrongAnswer")+(correctHTML?" — "+correctHTML:"")}</b>${why?`<small>${esc(why)}</small>`:""}</div></div>`;
 const nextB=document.createElement("button");nextB.className="btn pri full";nextB.style.marginTop="12px";nextB.textContent=T("next");
 nextB.onclick=()=>{PL.i++;PL.answered=false;PL.sel=null;PL.orderSel=null;PL.orderUsed=null;PL.matchLeft=null;PL.matchSel=null;PL.matchErr=0;PL.matchDone=0;PL.hint=false;if(PL.i>=PL.steps.length)finishLesson();else renderPlayer()};
 if(fb)fb.appendChild(nextB);nextB.focus();
 $$(".opt").forEach(o=>o.disabled=true);
}
