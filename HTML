let REC={m:null,chunks:[],url:null,ref:null};
async function toggleRec(){
 const btn=$("#recbtn");if(!btn)return;
 if(REC.m&&REC.m.state==="recording"){REC.m.stop();return}
 try{
  const stream=await navigator.mediaDevices.getUserMedia({audio:true});
  REC.chunks=[];REC.m=new MediaRecorder(stream);
  REC.m.ondataavailable=e=>REC.chunks.push(e.data);
  REC.m.onstop=()=>{stream.getTracks().forEach(t=>t.stop());REC.url=URL.createObjectURL(new Blob(REC.chunks,{type:"audio/webm"}));
   btn.innerHTML=`${ic("mic",17)} ${T("record")}`;btn.classList.remove("warn");btn.classList.add("sec");
   $("#recout").innerHTML=`<div class="card"><b>${T("yourRec")}</b><audio controls src="${REC.url}" style="width:100%;margin-top:8px"></audio></div><div class="card"><b>${T("reference")}</b><div class="row" style="margin:8px 0"><input class="input" id="refword" placeholder="${isAR()?"اكتب كلمة أو جملة…":"Type a word or sentence…"}" style="flex:1" value="Good morning"><button class="btn sec sm" data-say-good="#refword">${ic("vol",15)}</button></div></div>`};
  REC.m.start();toast(T("recStarted"));btn.innerHTML=`<span class="recwave">${"<i style='animation-delay:0s'></i><i style='animation-delay:.15s'></i><i style='animation-delay:.3s'></i><i style='animation-delay:.45s'></i>"}</span> ${T("stopRec")}`;btn.classList.add("warn");btn.classList.remove("sec");
