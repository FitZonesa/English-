const RANKS=[["مبتدئ","Beginner",0],["مستكشف","Explorer",250],["متعلّم","Learner",600],["متدرّب","Apprentice",1200],["ماهر","Skilled",2200],["متقدم","Advanced",3600],["خبير","Expert",5500],["أستاذ","Master",8000],["بطل الإنجليزية","English Champion",15000]];
const totalXP=()=>U().xpLedger.reduce((s,x)=>s+x.amount,0);
function rankOf(xp){let i=0;RANKS.forEach((r,ri)=>{if(xp>=r[2])i=ri});return i}
function grantXP(amount,reason){
 const d=U();if(!d||amount<=0)return;
 d.xpLedger.push({id:uid4(),at:Date.now(),amount,reason});
 const a=act();a.xp+=amount;
 // streak
 const t=todayKey();const st=d.streak;
 if(st.last!==t){const y=new Date();y.setDate(y.getDate()-1);const yk=y.getFullYear()+'-'+String(y.getMonth()+1).padStart(2,'0')+'-'+String(y.getDate()).padStart(2,'0');
  st.cur=(st.last===yk)?st.cur+1:1; st.last=t; st.dates.push(t); if(st.cur>st.best)st.best=st.cur;}
 STORE.save(); missionRefresh(); checkAch(); flashXP(); renderTopbarBits();
}
