   {t:"mcq",tag:"grammar",q:"الضمير المناسب: «أختي صغيرة» — My sister ___ young.",opts:["is","are","am","be"],a:0,why:"she (أختي) ← is."},
   {t:"fill",tag:"grammar",s:"___ am from Egypt.",a:["i"],why:"I am — أنا من."},
   {t:"trans",tag:"trans",ar:"نحن أصدقاء",a:["we are friends","we're friends"]},
   {t:"listen",say:"They are teachers",tag:"listen",q:"ماذا قيل؟",opts:["هم معلمون","هي معلمة","نحن معلمون","هو معلم"],a:0}]},
  {id:"a1-1-2",t:"am / is / are",steps:[
   {t:"info",title:"اقتران فعل be",body:`<div class="formula">I am · he/she/it is · you/we/they are</div><p>في العربية لا نحتاج فعلًا في الحاضر («أنا طالب»)، لكن الإنجليزية <b>تفرض</b> فعل be.</p><div class="exrow"><span class="en">She is my mother.</span><span class="ar">هي أمي.</span></div>`,audio:["She is my mother. I am a student. They are here."]},
   {t:"mcq",tag:"grammar",q:"We ___ students.",opts:["are","is","am","be"],a:0,why:"we ← are."},
   {t:"tf",tag:"grammar",q:"جملة <span class='en'>'He am tall'</span> صحيحة.",a:false,why:"الصحيح He is tall — he يأخذ is."},
   {t:"fill",tag:"grammar",s:"Look! The dogs ___ hungry.",a:["are"],why:"dogs جمع (they) ← are."},
   {t:"order",tag:"grammar",words:["They","are","from","Egypt"],a:"They are from Egypt",ar:"هم من مصر"},
   {t:"trans",tag:"trans",ar:"أنا طالب",a:["i am a student","im a student","i'm a student"]}]},
 ]},
 {u:"المضارع البسيط",en:"Present Simple",ls:[
  {id:"a1-2-1",t:"روتيني اليومي",en:"My Daily Routine",steps:[
   {t:"info",title:"المضارع البسيط للروتين",body:`<p>نستخدمه للعادات: <span class="en">I wake up at 7. I drink tea. I go to work.</span></p><p>مع he/she/it نضيف <b>s</b>: <span class="en">He works. She reads.</span></p><div class="exrow"><span class="en">I drink coffee every morning.</span><span class="ar">أشرب القهوة كل صباح.</span></div>`,audio:["I drink coffee every morning."]},
   {t:"match",tag:"vocab",pairs:[{en:"wake up",ar:"يستيقظ"},{en:"eat breakfast",ar:"يتناول الفطور"},{en:"go to work",ar:"يذهب للعمل"},{en:"sleep",ar:"ينام"}]},
   {t:"mcq",tag:"grammar",q:"She ___ to school every day.",opts:["goes","go","going","gos"],a:0,why:"she + go → goes (نضيف es)."},
   {t:"fill",tag:"grammar",s:"I ___ (study) English every day.",a:["study"],why:"I لا تحتاج s."},
   {t:"trans",tag:"trans",ar:"أشرب القهوة كل صباح",a:["i drink coffee every morning"]},
   {t:"listen",say:"He works in a hospital",tag:"listen",q:"أين يعمل؟",opts:["في مستشفى","في مدرسة","في مصرف","في مطعم"],a:0}]},
  {id:"a1-2-2",t:"النفي والسؤال: do / does",steps:[
   {t:"info",title:"do و does",body:`<div class="formula">I/you/we/they + don't + فعل · he/she/it + doesn't + فعل</div><div class="formula">Do you…? · Does he…? + الفعل المجرد</div><p>عند استخدام do/does يعود الفعل مجردًا بلا s: <span class="en">Does he like tea?</span></p>`,audio:["Does he like tea? She doesn't work here."]},
   {t:"mcq",tag:"grammar",q:"أي جملة صحيحة؟",opts:["Does he like tea?","Does he likes tea?","Do he like tea?","He does like tea?"],a:0,why:"بعد does يأتي الفعل مجردًا: like."},
   {t:"tf",tag:"grammar",q:"جملة <span class='en'>'He don't like coffee'</span> صحيحة.",a:false,why:"الصحيح: He doesn't like coffee."},
   {t:"fill",tag:"grammar",s:"She ___ live in Cairo.",a:["doesnt","doesn't"],why:"النفي مع she = doesn't."},
   {t:"order",tag:"grammar",words:["Where","do","you","live?"],a:"Where do you live?",ar:"أين تسكن؟"},
   {t:"trans",tag:"trans",ar:"هو لا يعمل هنا",a:["he doesnt work here","he does not work here"]}]},
 ]},
 {u:"أدوات النكر والتعريف",en:"Articles: a, an, the",ls:[
  {id:"a1-3-1",t:"a / an / the",steps:[
   {t:"info",title:"متى نستخدم a / an / the؟",body:`<p><b>a</b> قبل صوت ساكن: <span class="en">a car, a house</span>. <b>an</b> قبل صوت متحرك: <span class="en">an apple, an hour</span>. <b>the</b> للمعرَّف: <span class="en">the sun, the door</span>.</p><p>العربية لا تملك أدوات نكر، لذا ينساها المتحدث العربي كثيرًا: «I have car» خطأ.</p>`,audio:["I have a car. She is an engineer. The sun is hot."]},
   {t:"mcq",tag:"grammar",q:"I want ___ apple.",opts:["an","a","the","—"],a:0,why:"apple تبدأ بصوت متحرك ← an."},
   {t:"fill",tag:"grammar",s:"She is ___ engineer.",a:["an"],why:"engineer تبدأ بصوت /e/ متحرك."},
   {t:"tf",tag:"grammar",q:"نقول <span class='en'>'I have a car'</span> لا <span class='en'>'I have car'</span>.",a:true,why:"الاسم المفرد النكرة يحتاج a/an دائمًا."},
   {t:"order",tag:"grammar",words:["The","sun","is","hot"],a:"The sun is hot",ar:"الشمس حارة"},
   {t:"trans",tag:"trans",ar:"هذا كتاب",a:["this is a book"]}]},
  {id:"a1-3-2",t:"مراجعة الوحدات 1–3",type:"review",steps:[
   {t:"mcq",tag:"grammar",q:"My brother ___ a doctor.",opts:["is","are","am","be"],a:0},
   {t:"mcq",tag:"grammar",q:"He ___ football on Fridays.",opts:["plays","play","playing","to play"],a:0,why:"he ← plays."},
   {t:"fill",tag:"grammar",s:"I have ___ orange and ___ banana.",a:["an a","an and a"],why:"an orange (صوت متحرك) + a banana."},
   {t:"trans",tag:"trans",ar:"هي معلمة",a:["she is a teacher","she's a teacher"]},
   {t:"listen",say:"I eat an apple every day",tag:"listen",q:"ماذا يأكل كل يوم؟",opts:["تفاحة","برتقالة","موزة","سلعة"],a:0},
   {t:"spell",word:"mother",ar:"أم",tag:"spell"}]},
 ]},
 {u:"There is / There are",en:"There is & There are",ls:[
  {id:"a1-4-1",t:"يوجد / توجد",steps:[
   {t:"info",title:"التعبير عن الوجود",body:`<div class="formula">There is + مفرد · There are + جمع</div><div class="exrow"><span class="en">There is a book on the table.</span><span class="ar">يوجد كتاب على الطاولة.</span></div><div class="exrow"><span class="en">There are three cats in the garden.</span><span class="ar">توجد ثلاث قطط في الحديقة.</span></div><p>خطأ شائع: <s>There is two books</s> — الجمع يأخذ are.</p>`,audio:["There is a book on the table. There are three cats in the garden."]},
   {t:"mcq",tag:"grammar",q:"There ___ two cats under the tree.",opts:["are","is","be","am"],a:0,why:"two cats جمع ← are."},
   {t:"fill",tag:"grammar",s:"There ___ a big tree in the garden.",a:["is"],why:"a tree مفرد ← is."},
   {t:"tf",tag:"grammar",q:"جملة <span class='en'>'There is many people here'</span> صحيحة.",a:false,why:"الصحيح There are many people."},
   {t:"order",tag:"grammar",words:["There","are","three","books","on","the","table"],a:"There are three books on the table",ar:"توجد ثلاثة كتب على الطاولة"},
   {t:"listen",say:"There are four chairs in the room",tag:"listen",q:"كم كرسيًا في الغرفة؟",opts:["4","3","5","14"],a:0}]},
  {id:"a1-4-2",t:"حروف الجر: in, on, under",steps:[
   {t:"info",title:"مواقع الأشياء",body:`<div class="abcgrid">${[["in","داخل"],["on","على"],["under","تحت"],["next to","بجانب"],["behind","خلف"],["between","بين"]].map(([w,a])=>`<div class="abc"><div class="L" style="font-size:17px">${w}</div><div class="w">${a}</div></div>`).join("")}</div>`,audio:["The cat is under the table. The book is on the chair."]},
   {t:"mcq",tag:"grammar",q:"القطة ___ الطاولة (تحتها).",opts:["under","on","in","behind"],a:0,why:"under = تحت."},
   {t:"fill",tag:"grammar",s:"The lamp is ___ to the bed.",a:["next"],why:"next to = بجانب."},
   {t:"trans",tag:"trans",ar:"القطة تحت الطاولة",a:["the cat is under the table"]},
   {t:"listen",say:"The keys are on the table",tag:"listen",q:"أين المفاتيح؟",opts:["على الطاولة","تحت الطاولة","في الحقيبة","بجانب الباب"],a:0},
   {t:"spell",word:"under",ar:"تحت",tag:"spell"}]},
 ]},
 {u:"Can / Can't والصفات",en:"Can & Adjectives",ls:[
  {id:"a1-5-1",t:"القدرة: can / can't",steps:[
   {t:"info",title:"can للقدرة",body:`<div class="formula">can + الفعل المجرد (بلا to وبلا s)</div><div class="exrow"><span class="en">I can swim.</span><span class="ar">أستطيع السباحة.</span></div><div class="exrow"><span class="en">She can't drive.</span><span class="ar">هي لا تستطيع القيادة.</span></div><p>خطأ شائع: <s>I can to swim</s> — لا نضع to بعد can.</p>`,audio:["I can swim. She can't drive."]},
   {t:"mcq",tag:"grammar",q:"أي جملة صحيحة؟",opts:["I can swim","I can to swim","I can swimming","I cans swim"],a:0,why:"can + الفعل المجرد."},
   {t:"fill",tag:"grammar",s:"He can ___ (speak) three languages.",a:["speak"],why:"بعد can فعل مجرد بلا s."},
   {t:"order",tag:"grammar",words:["Can","you","help","me?"],a:"Can you help me?",ar:"هل تستطيع مساعدتي؟"},
   {t:"trans",tag:"trans",ar:"أستطيع السباحة",a:["i can swim"]},
   {t:"listen",say:"Can you close the window?",tag:"listen",q:"ماذا طُلب؟",opts:["إغلاق النافذة","فتح النافذة","تنظيف النافذة","شراء نافذة"],a:0}]},
  {id:"a1-5-2",t:"صفات الوصف",en:"Describing with adjectives",steps:[
   {t:"info",title:"الصفة قبل الاسم",body:`<p>في العربية الصفة تأتي بعد الاسم («سيارة حمراء»)، في الإنجليزية <b>قبل</b> الاسم: <span class="en">a red car</span>.</p><div class="exrow"><span class="en">a big house</span><span class="ar">بيت كبير</span></div><div class="exrow"><span class="en">She is beautiful.</span><span class="ar">هي جميلة.</span></div><p>خطأ شائع: <s>a car red</s>.</p>`,audio:["a big house. a red car."]},
   {t:"mcq",tag:"grammar",q:"أي ترتيب صحيح؟",opts:["a small dog","a dog small","small a dog","dog a small"],a:0,why:"الصفة قبل الاسم وبعد الأداة."},
   {t:"fill",tag:"grammar",s:"I have a ___ (new) phone.",a:["new"],why:"new صفة قبل phone."},
   {t:"trans",tag:"trans",ar:"بيت كبير",a:["a big house"]},
   {t:"match",tag:"vocab",pairs:[{en:"easy",ar:"سهل"},{en:"difficult",ar:"صعب"},{en:"beautiful",ar:"جميل"},{en:"fast",ar:"سريع"}]},
   {t:"listen",say:"It is a very difficult question",tag:"listen",q:"كيف كان السؤال؟",opts:["صعب جدًا","سهل جدًا","طويل","قديم"],a:0}]},
 ]},
 {u:"أسئلة Wh ومراجعة A1",en:"Wh-questions & A1 Review",ls:[
  {id:"a1-6-1",t:"أسئلة Wh",steps:[
   {t:"info",title:"أدوات الاستفهام",body:`<div class="abcgrid">${[["What","ماذا"],["Where","أين"],["Who","مَن"],["When","متى"],["Why","لماذا"],["How","كيف"]].map(([w,a])=>`<div class="abc"><div class="L" style="font-size:17px">${w}</div><div class="w">${a}</div></div>`).join("")}</div><div class="formula">Wh + do/does + الفاعل + الفعل؟</div>`,audio:["What do you do? Where do you live?"]},
   {t:"mcq",tag:"grammar",q:"___ do you live? — In Cairo.",opts:["Where","What","Who","When"],a:0,why:"المكان ← Where."},
   {t:"fill",tag:"grammar",s:"___ is your name? — Ali.",a:["what"],why:"الاسم ← What."},
   {t:"order",tag:"grammar",words:["When","does","the","movie","start?"],a:"When does the movie start?",ar:"متى يبدأ الفيلم؟"},
   {t:"trans",tag:"trans",ar:"أين تعمل؟",a:["where do you work"]},
   {t:"listen",say:"Why do you study English?",tag:"listen",q:"ما السؤال؟",opts:["لماذا تدرس الإنجليزية؟","متى تدرس؟","أين تدرس؟","كيف تدرس؟"],a:0}]},
  {id:"a1-6-2",t:"المراجعة الشاملة لـ A1",type:"review",steps:[
   {t:"mcq",tag:"grammar",q:"There ___ a lot of people at the party.",opts:["are","is","am","can"],a:0},
   {t:"mcq",tag:"grammar",q:"She ___ like fish.",opts:["doesn't","don't","isn't","not"],a:0,why:"she ← doesn't."},
   {t:"fill",tag:"grammar",s:"My father ___ (work) in a bank.",a:["works"],why:"مفرد غائب ← works."},
   {t:"trans",tag:"trans",ar:"هل تستطيع مساعدتي؟",a:["can you help me"]},
   {t:"order",tag:"grammar",words:["I","am","from","Saudi","Arabia"],a:"I am from Saudi Arabia",ar:"أنا من السعودية"},
   {t:"spell",word:"family",ar:"عائلة",tag:"spell"},
   {t:"listen",say:"We can see the sea from the window",tag:"listen",q:"ماذا يريدان من النافذة؟",opts:["البحر","الشمس","الجبل","الحديقة"],a:0}]},
  {id:"a1-final",t:"التقييم النهائي لمستوى A1",type:"assessment",pool:"a1"},
 ]},
]},
a2:[
 {u:"المضارع المستمر",en:"Present Continuous",ls:[
  {id:"a2-1-1",t:"am/is/are + V-ing",steps:[
   {t:"info",title:"الحدث الجاري الآن",body:`<div class="formula">am / is / are + الفعل + ing</div><div class="exrow"><span class="en">I am cooking dinner now.</span><span class="ar">أطبخ العشاء الآن.</span></div><div class="exrow"><span class="en">Look! It is raining.</span><span class="ar">انظر! إنها تمطر.</span></div><p>خطأ شائع: <s>I am go</s> — لا بد من ing بعد be.</p>`,audio:["I am cooking dinner now. Look! It is raining."]},
   {t:"mcq",tag:"grammar",q:"Look! The baby ___ .",opts:["is sleeping","sleeps","sleeping","are sleeping"],a:0,why:"حدث الآن + be + ing."},
   {t:"fill",tag:"grammar",s:"They ___ (watch) TV at the moment.",a:["are watching"],why:"they ← are + watching."},
   {t:"tf",tag:"grammar",q:"جملة <span class='en'>'I am go to school now'</span> صحيحة.",a:false,why:"الصحيح: I am going."},
   {t:"order",tag:"grammar",words:["She","is","reading","a","book"],a:"She is reading a book",ar:"هي تقرأ كتابًا"},
   {t:"trans",tag:"trans",ar:"أعمل الآن",a:["i am working now","im working now","i'm working now"]}]},
  {id:"a2-1-2",t:"مستمر أم بسيط؟",steps:[
   {t:"info",title:"الفرق",body:`<p>المستمر = الآن/حول الآن (<span class="en">now, at the moment, Look!</span>). البسيط = عادة دائمة (<span class="en">every day, usually, always</span>).</p><div class="exrow"><span class="en">I work every day. / I am working now.</span><span class="ar">أعمل كل يوم / أعمل الآن.</span></div>`,audio:["I work every day. I am working now."]},
   {t:"mcq",tag:"grammar",q:"She usually ___ tea, but today she ___ coffee.",opts:["drinks / is drinking","drink / drinks","is drinking / drinks","drinks / drink"],a:0,why:"usually ← بسيط، today (استثناء جارٍ) ← مستمر."},
   {t:"fill",tag:"grammar",s:"Listen! Someone ___ (sing).",a:["is singing"],why:"Listen! = الآن ← مستمر."},
   {t:"trans",tag:"trans",ar:"أشرب القهوة كل صباح",a:["i drink coffee every morning"]},
   {t:"listen",say:"The children are playing in the garden",tag:"listen",q:"ماذا يفعل الأطفال؟",opts:["يلعبون في الحديقة","ينامون","ياكلون","يدرسون"],a:0},
   {t:"spell",word:"raining",ar:"تمطر",tag:"spell"}]},
 ]},
 {u:"الماضي البسيط",en:"Past Simple",ls:[
  {id:"a2-2-1",t:"was / were والافعال المنتظمة",steps:[
   {t:"info",title:"الماضي من be ومن الأفعال المنتظمة",body:`<div class="formula">was (I/he/she/it) · were (you/we/they)</div><div class="formula">الفعل + ed  (visited, watched, played)</div><div class="exrow"><span class="en">I was at home yesterday.</span><span class="ar">كنت في البيت أمس.</span></div><div class="exrow"><span class="en">We watched a movie last night.</span><span class="ar">شاهدنا فيلمًا ليلة أمس.</span></div>`,audio:["I was at home yesterday. We watched a movie last night."]},
   {t:"mcq",tag:"grammar",q:"Yesterday I ___ my friend.",opts:["visited","visit","visiting","am visiting"],a:0,why:"yesterday ← ماضٍ بسيط + ed."},
   {t:"fill",tag:"grammar",s:"They ___ at school last week.",a:["were"],why:"they في الماضي ← were."},
   {t:"tf",tag:"grammar",q:"الماضي من go هو goed.",a:false,why:"go فعل شاذ: went."},
   {t:"order",tag:"grammar",words:["We","went","to","the","beach","last","weekend"],a:"We went to the beach last weekend",ar:"ذهبنا للشاطئ نهاية الأسبوع الماضي"},
   {t:"trans",tag:"trans",ar:"شاهدت فيلمًا أمس",a:["i watched a movie yesterday"]}]},
  {id:"a2-2-2",t:"الماضي الشاذ و did",steps:[
   {t:"info",title:"أفعال شائعة شاذة",body:`<div class="abcgrid">${[["go","went"],["eat","ate"],["see","saw"],["come","came"],["buy","bought"],["take","took"],["make","made"],["have","had"]].map(([a,b])=>`<div class="abc"><div class="l" style="font-size:15px">${a}</div><div class="L" style="font-size:15px">${b}</div></div>`).join("")}</div><p>السؤال والنفي بـ <b>did</b> يعيدان الفعل مجردًا: <span class="en">Did you go? She didn't come.</span></p>`,audio:["Did you go? She didn't come."]},
   {t:"mcq",tag:"grammar",q:"أي جملة صحيحة؟",opts:["Did you see him?","Did you saw him?","Did you seen him?","Do you saw him?"],a:0,why:"بعد did فعل مجرد: see."},
   {t:"fill",tag:"grammar",s:"I didn't ___ (buy) anything.",a:["buy"],why:"didn't + الفعل المجرد."},
   {t:"match",tag:"vocab",pairs:[{en:"ate",ar:"أكل (ماضٍ)"},{en:"went",ar:"ذهب (ماضٍ)"},{en:"saw",ar:"رأى (ماضٍ)"},{en:"took",ar:"أخذ (ماضٍ)"}]},
   {t:"trans",tag:"trans",ar:"ذهبت إلى باريس عام 2020",a:["i went to paris in 2020"]},
   {t:"listen",say:"They arrived very late last night",tag:"listen",q:"متى وصلوا؟",opts:["متأخرين جدًا ليلة أمس","باكرًا أمس","الآن","بعد قليل"],a:0}]},
 ]},
 {u:"المقارنة والتفضيل",en:"Comparatives & Superlatives",ls:[
  {id:"a2-3-1",t:"-er / -est / more",steps:[
   {t:"info",title:"المقارنة",body:`<div class="formula">قصير: adj + er + than · طويل: more + adj + than · التفضيل: the + est / the most</div><div class="exrow"><span class="en">Cairo is bigger than Alexandria.</span><span class="ar">القاهرة أكبر من الإسكندرية.</span></div><div class="exrow"><span class="en">This is the most beautiful city.</span><span class="ar">هذه أجمل مدينة.</span></div><p>خطأ شائع: <s>more better</s> — لا نجمع بين more و er.</p>`,audio:["Cairo is bigger than Alexandria. This is the most beautiful city."]},
   {t:"mcq",tag:"grammar",q:"أي صيغة صحيحة للمقارنة؟",opts:["bigger","more bigger","biger","most big"],a:0,why:"نضيف er مع مضاعفة g."},
   {t:"fill",tag:"grammar",s:"This book is ___ (interesting) than that one.",a:["more interesting"],why:"الصفة الطويلة ← more."},
   {t:"tf",tag:"grammar",q:"جملة <span class='en'>'This is more better'</span> صحيحة.",a:false,why:"double comparative ممنوع."},
   {t:"order",tag:"grammar",words:["This","is","the","tallest","building"],a:"This is the tallest building",ar:"هذا أطول مبنى"},
   {t:"trans",tag:"trans",ar:"هذا أطول مبنى",a:["this is the tallest building"]}]},
 ]},
 {u:"المستقبل will / going to",en:"Future: will & going to",ls:[
  {id:"a2-4-1",t:"خطط وتوقعات",steps:[
   {t:"info",title:"will مقابل going to",body:`<p><b>will</b>: قرار فوري أو توقع — <span class="en">I will help you. It will rain, I think.</span></p><p><b>going to</b>: خطة مسبقة — <span class="en">We are going to travel next month.</span></p>`,audio:["I will help you. We are going to travel next month."]},
   {t:"mcq",tag:"grammar",q:"Look at those clouds! It ___ rain.",opts:["is going to","wills","will to","going"],a:0,why:"دليل مرئي ← going to."},
   {t:"fill",tag:"grammar",s:"I think our team ___ win.",a:["will"],why:"توقع ← will."},
   {t:"order",tag:"grammar",words:["We","are","going","to","travel","next","month"],a:"We are going to travel next month",ar:"سنسافر الشهر القادم"},
   {t:"trans",tag:"trans",ar:"سأتصل بك لاحقًا",a:["i will call you later","ill call you later","i'll call you later"]},
   {t:"listen",say:"She will arrive at six o'clock",tag:"listen",q:"متى ستصل؟",opts:["السادسة","السابعة","الآن","غدًا"],a:0}]},
 ]},
 {u:"مقدمة المضارع التام ومراجعة",en:"Present Perfect Intro & Review",ls:[
  {id:"a2-5-1",t:"have / has + التصريف الثالث",steps:[
   {t:"info",title:"التجارب والاتصال بالحاضر",body:`<div class="formula">have / has + V3 (past participle)</div><div class="exrow"><span class="en">I have visited London twice.</span><span class="ar">زرت لندن مرتين.</span></div><div class="exrow"><span class="en">She has just finished her homework.</span><span class="ar">أنهت واجبها للتو.</span></div><p>كلمات مرافقة: <span class="en">ever, never, just, already, yet</span>.</p>`,audio:["I have visited London twice. She has just finished her homework."]},
   {t:"mcq",tag:"grammar",q:"I have ___ this movie before.",opts:["seen","saw","see","seeing"],a:0,why:"بعد have نستخدم التصريف الثالث: seen."},
   {t:"fill",tag:"grammar",s:"She ___ (finish) her work already.",a:["has finished"],why:"she ← has + V3."},
   {t:"tf",tag:"grammar",q:"نقول <span class='en'>'I have seen him yesterday'</span>.",a:false,why:"مع وقت ماضٍ محدد (yesterday) نستخدم الماضي البسيط: I saw him yesterday."},
   {t:"trans",tag:"trans",ar:"لم أزر لندن قط",a:["i have never visited london","i have never been to london","i havent visited london","i haven't visited london"]},
   {t:"listen",say:"Have you ever been to Turkey?",tag:"listen",q:"ما السؤال؟",opts:["هل زرت تركيا يومًا؟","هل تحب تركيا؟","متى زرت تركيا؟","أين تركيا؟"],a:0}]},
  {id:"a2-5-2",t:"المراجعة الشاملة لـ A2",type:"review",steps:[
   {t:"mcq",tag:"grammar",q:"Be quiet! The baby ___ .",opts:["is sleeping","sleeps","slept","sleep"],a:0},
   {t:"mcq",tag:"grammar",q:"We ___ to Rome in 2019.",opts:["went","have gone","go","was going"],a:0,why:"2019 وقت محدد ← ماضٍ بسيط."},
   {t:"fill",tag:"grammar",s:"This exam is ___ (easy) than the last one.",a:["easier"],why:"صفة قصيرة + er."},
   {t:"trans",tag:"trans",ar:"لقد أكلت للتو",a:["i have just eaten","i've just eaten","ive just eaten"]},
   {t:"order",tag:"grammar",words:["Are","you","going","to","buy","a","car?"],a:"Are you going to buy a car?",ar:"هل تنوي شراء سيارة؟"},
   {t:"spell",word:"weather",ar:"طقس",tag:"spell"},
   {t:"listen",say:"I have never eaten sushi before",tag:"listen",q:"ماذا لم يجربه أبدًا؟",opts:["السوشي","البيتزا","المكرونة","السلطة"],a:0}]},
  {id:"a2-final",t:"التقييم النهائي لمستوى A2",type:"assessment",pool:"a2"},
 ]},
]},
b1:[
 {u:"المضارع التام مقابل الماضي",en:"Present Perfect vs Past Simple",ls:[
  {id:"b1-1-1",t:"متى نستخدم كلاً منهما؟",steps:[
   {t:"info",title:"القاعدة الذهبية",body:`<p>وقت <b>محدد منتهٍ</b> (yesterday, in 2020, last week) ← ماضٍ بسيط. زمن غير محدد أو متصل بالحاضر (ever, since, already, this week) ← مضارع تام.</p><div class="exrow"><span class="en">I went to Paris in 2020.</span><span class="ar">ذهبت لباريس عام 2020.</span></div><div class="exrow"><span class="en">I have lived here for five years.</span><span class="ar">أعيش هنا منذ خمس سنوات.</span></div>`,audio:["I went to Paris in 2020. I have lived here for five years."]},
   {t:"mcq",tag:"grammar",q:"___ you ever ___ to Japan?",opts:["Have / been","Did / been","Have / went","Do / go"],a:0,why:"ever (تجربة) ← have been."},
   {t:"fill",tag:"grammar",s:"She ___ (leave) the office an hour ago.",a:["left"],why:"ago وقت منتهٍ ← ماضٍ بسيط."},
   {t:"tf",tag:"grammar",q:"جملة <span class='en'>'I have finished it two hours ago'</span> صحيحة.",a:false,why:"ago ← ماضٍ بسيط: I finished it two hours ago."},
   {t:"trans",tag:"trans",ar:"أعيش في هذا البيت منذ 2015",a:["i have lived in this house since 2015","ive lived in this house since 2015"]},
   {t:"listen",say:"I have known him since we were children",tag:"listen",q:"منذ متى يعرفه؟",opts:["منذ الطفولة","منذ سنة","منذ الشهر الماضي","منذ أمس"],a:0}]},
  {id:"b1-1-2",t:"مراجعة الوحدة",type:"review",steps:[
   {t:"mcq",tag:"grammar",q:"I ___ my keys — I can't find them!",opts:["have lost","lost","lose","am losing"],a:0,why:"نتيجة ظاهرة الآن ← مضارع تام."},
   {t:"fill",tag:"grammar",s:"We ___ (not / finish) the project yet.",a:["havent finished","haven't finished","have not finished"],why:"yet ← مضارع تام منفي."},
   {t:"trans",tag:"trans",ar:"درست الإنجليزية عندما كنت طفلًا",a:["i studied english when i was a child"]},
   {t:"order",tag:"grammar",words:["How","long","have","you","worked","here?"],a:"How long have you worked here?",ar:"منذ متى تعمل هنا؟"},
   {t:"listen",say:"He has already left the office",tag:"listen",q:"ماذا حدث؟",opts:["لقد غادر المكتب بالفعل","سيغادر المكتب","لم يغادر أبدًا","يغادر الآن"},a:0}]},
 ]},
 {u:"الشرط الأول والصفري",en:"Zero & First Conditional",ls:[
  {id:"b1-2-1",t:"if + مضارع، will",steps:[
   {t:"info",title:"الجمل الشرطية",body:`<div class="formula">Zero: if + present, present (حقائق عامة)</div><div class="formula">First: if + present, will + فعل (مستقبل محتمل)</div><div class="exrow"><span class="en">If you heat water, it boils.</span><span class="ar">إذا سخّنت الماء يغلي.</span></div><div class="exrow"><span class="en">If it rains, we will stay home.</span><span class="ar">إذا أمطرت سنبقى في البيت.</span></div><p>خطأ شائع جدًا: <s>If it will rain…</s> — لا will بعد if.</p>`,audio:["If you heat water, it boils. If it rains, we will stay home."]},
   {t:"mcq",tag:"grammar",q:"If you study hard, you ___ the exam.",opts:["will pass","pass to","are passing","would pass"],a:0,why:"الشرط الأول: will في الجملة الثانية."},
   {t:"fill",tag:"grammar",s:"If she ___ (come) early, we will start together.",a:["comes"],why:"بعد if مضارع بسيط: comes."},
   {t:"tf",tag:"grammar",q:"نقول <span class='en'>'If it will rain, I will stay'</span>.",a:false,why:"لا نستخدم will بعد if."},
   {t:"order",tag:"grammar",words:["If","you","study","hard,","you","will","succeed"],a:"If you study hard you will succeed",ar:"إذا درست بجد ستنجح"},
   {t:"trans",tag:"trans",ar:"إذا أمطرت سنبقى في البيت",a:["if it rains we will stay home","if it rains well stay home","if it rains we'll stay home"]}]},
  {id:"b1-final",t:"التقييم النهائي لمستوى B1",type:"assessment",pool:"b1"},
 ]},
]};

/* flatten lesson lookup */
const LESSONS={}; LEVELS.forEach(l=>{(CURRICULUM[l.id]||[]).forEach((u,ui)=>u.ls.forEach((ls,li)=>{LESSONS[ls.id]={...ls,level:l.id,unit:u.u,unitEn:u.en,ui,li,levelObj:l}}))});
function levelFlat(lid){return (CURRICULUM[lid]||[]).flatMap(u=>u.ls)}
function levelLessons(lid){return levelFlat(lid).filter(x=>x.type!=="assessment")}
function findLesson(lid){return (CURRICULUM[lid]||[]).flatMap(u=>u.ls).find(x=>x.type==="assessment")}

